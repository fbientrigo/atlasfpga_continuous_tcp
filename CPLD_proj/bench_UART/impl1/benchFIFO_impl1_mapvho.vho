    END IF;

    WADO0_zd 	:= WADO0_out;
    WADO1_zd 	:= WADO1_out;
    WADO2_zd 	:= WADO2_out;
    WADO3_zd 	:= WADO3_out;
    WDO0_zd 	:= WDO0_out;
    WDO1_zd 	:= WDO1_out;
    WDO2_zd 	:= WDO2_out;
    WDO3 	<= WDO3_out;

    VitalPathDelay01 (
