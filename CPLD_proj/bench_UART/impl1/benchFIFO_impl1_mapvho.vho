                           PathDelay => tpd_B1_F1,
                           PathCondition => TRUE),
                     3 => (InputChangeTime => A1_ipd'last_event,
                           PathDelay => tpd_A1_F1,
                           PathCondition => TRUE),
                     4 => (InputChangeTime => WCK_dly'last_event,
                           PathDelay => tpd_WCK_F1,
                           PathCondition => TRUE)),
