    VARIABLE tviol_WRE_WCK       	: x01 := '0';
    VARIABLE WRE_WCK_TimingDatash	: VitalTimingDataType;
    VARIABLE tviol_WAD0_WCK       	: x01 := '0';
    VARIABLE WAD0_WCK_TimingDatash	: VitalTimingDataType;
    VARIABLE tviol_WAD1_WCK       	: x01 := '0';
