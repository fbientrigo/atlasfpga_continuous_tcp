  begin
    fifo_fifo_pfu_13_1_WD0_INT: bufferB
      port map (I=>A1_ipd, Z=>WDO0_out);
    fifo_fifo_pfu_13_1_WD1_INT: bufferB
      port map (I=>B1_ipd, Z=>WDO1_out);
