    signal WD0_dly 	: std_logic := 'X';
    signal WD1_ipd 	: std_logic := 'X';
    signal WD1_dly 	: std_logic := 'X';

    component ec2dpram
      port (DI0: in Std_logic; DI1: in Std_logic; RA0: in Std_logic; 
            RA1: in Std_logic; RA2: in Std_logic; RA3: in Std_logic; 
            WA0: in Std_logic; WA1: in Std_logic; WA2: in Std_logic; 
            WA3: in Std_logic; WRE: in Std_logic; WCK: in Std_logic; 
            DO0: out Std_logic; DO1: out Std_logic);
