  begin
    fifo_fifo_pfu_29_1_WD0_INT: bufferB
      port map (I=>A1_ipd, Z=>WDO0_out);
    fifo_fifo_pfu_29_1_WD1_INT: bufferB
      port map (I=>B1_ipd, Z=>WDO1_out);
    fifo_fifo_pfu_29_1_WD2_INT: bufferB
      port map (I=>C1_ipd, Z=>WDO2_out);
    fifo_fifo_pfu_29_1_WD3_INT: bufferB
      port map (I=>D1_ipd, Z=>WDO3_out);
    fifo_fifo_pfu_29_1_WAD0_INT: bufferB
      port map (I=>A0_ipd, Z=>WADO0_out);
    fifo_fifo_pfu_29_1_WAD1_INT: bufferB
      port map (I=>B0_ipd, Z=>WADO1_out);
    fifo_fifo_pfu_29_1_WAD2_INT: bufferB
      port map (I=>C0_ipd, Z=>WADO2_out);
