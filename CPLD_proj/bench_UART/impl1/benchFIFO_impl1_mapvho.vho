    signal WDO1_out 	: std_logic := 'X';
    signal WDO2_out 	: std_logic := 'X';
    signal WDO3_out 	: std_logic := 'X';

    signal GNDI: Std_logic;
    component gnd
      port (PWR0: out Std_logic);
    end component;
    component bufferB
      port (I: in Std_logic; Z: out Std_logic);
    end component;
  begin
    fifo_fifo_pfu_10_0_WD0_INT: bufferB
      port map (I=>A1_ipd, Z=>WDO0_out);
    fifo_fifo_pfu_10_0_WD1_INT: bufferB
      port map (I=>B1_ipd, Z=>WDO1_out);
