      tsetup_WRE_WCK_noedge_posedge	: VitalDelayType := 0 ns;
      thold_WRE_WCK_noedge_posedge	: VitalDelayType := 0 ns;
      tisd_WAD0_WCK	: VitalDelayType := 0 ns;
      tsetup_WAD0_WCK_noedge_posedge	: VitalDelayType := 0 ns;
