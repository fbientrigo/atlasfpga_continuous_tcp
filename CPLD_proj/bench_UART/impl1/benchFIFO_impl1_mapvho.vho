      port map (PWR0=>GNDI);
    fifo_fifo_pfu_5_0_WAD0_INT: bufferB
      port map (I=>A0_ipd, Z=>WADO0_out);
    fifo_fifo_pfu_5_0_WAD1_INT: bufferB
