-- entity uart_txB
  library IEEE, vital2000, MACHXO3D;
  use IEEE.STD_LOGIC_1164.all;
  use vital2000.vital_timing.all;
  use MACHXO3D.COMPONENTS.ALL;

  entity uart_txB is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "uart_txB";

      tipd_PADDO  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_PADDO_uarttx	 : VitalDelayType01 := (0 ns, 0 ns));

    port (PADDO: in Std_logic; uarttx: out Std_logic);

    ATTRIBUTE Vital_Level0 OF uart_txB : ENTITY IS TRUE;

  end uart_txB;

  architecture Structure of uart_txB is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

    signal PADDO_ipd 	: std_logic := 'X';
    signal uarttx_out 	: std_logic := 'X';

    signal GNDI: Std_logic;
    component gnd
      port (PWR0: out Std_logic);
    end component;
    component se5iobuf
      port (I: in Std_logic; T: in Std_logic; PAD: out Std_logic);
    end component;
  begin
    uart_tx_pad: se5iobuf
      port map (I=>PADDO_ipd, T=>GNDI, PAD=>uarttx_out);
    DRIVEGND: gnd
      port map (PWR0=>GNDI);

    --  INPUT PATH DELAYs
    WireDelay : BLOCK
    BEGIN
      VitalWireDelay(PADDO_ipd, PADDO, tipd_PADDO);
    END BLOCK;

    VitalBehavior : PROCESS (PADDO_ipd, uarttx_out)
    VARIABLE uarttx_zd         	: std_logic := 'X';
    VARIABLE uarttx_GlitchData 	: VitalGlitchDataType;


    BEGIN

    IF (TimingChecksOn) THEN

    END IF;

    uarttx_zd 	:= uarttx_out;

    VitalPathDelay01 (
      OutSignal => uarttx, OutSignalName => "uarttx", OutTemp => uarttx_zd,
      Paths      => (0 => (InputChangeTime => PADDO_ipd'last_event,
                           PathDelay => tpd_PADDO_uarttx,
                           PathCondition => TRUE)),
      GlitchData => uarttx_GlitchData,
      Mode       => vitaltransport, XOn => XOn, MsgOn => MsgOn);

    END PROCESS;

  end Structure;

