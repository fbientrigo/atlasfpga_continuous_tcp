    component gnd
      port (PWR0: out Std_logic);
    end component;
    component bufferB
      port (I: in Std_logic; Z: out Std_logic);
    end component;
  begin
    fifo_fifo_pfu_28_0_WD0_INT: bufferB
      port map (I=>A1_ipd, Z=>WDO0_out);
    fifo_fifo_pfu_28_0_WD1_INT: bufferB
      port map (I=>B1_ipd, Z=>WDO1_out);
    fifo_fifo_pfu_28_0_WD2_INT: bufferB
      port map (I=>C1_ipd, Z=>WDO2_out);
    fifo_fifo_pfu_28_0_WD3_INT: bufferB
      port map (I=>GNDI, Z=>WDO3_out);
    DRIVEGND: gnd
      port map (PWR0=>GNDI);
    fifo_fifo_pfu_28_0_WAD0_INT: bufferB
      port map (I=>A0_ipd, Z=>WADO0_out);
    fifo_fifo_pfu_28_0_WAD1_INT: bufferB
      port map (I=>B0_ipd, Z=>WADO1_out);
    fifo_fifo_pfu_28_0_WAD2_INT: bufferB
      port map (I=>C0_ipd, Z=>WADO2_out);
    fifo_fifo_pfu_28_0_WAD3_INT: bufferB
      port map (I=>D0_ipd, Z=>WADO3_out);

