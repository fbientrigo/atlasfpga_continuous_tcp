      port map (PWR0=>GNDI);
    fifo_fifo_pfu_7_0_WAD0_INT: bufferB
      port map (I=>A0_ipd, Z=>WADO0_out);
    fifo_fifo_pfu_7_0_WAD1_INT: bufferB
      port map (I=>B0_ipd, Z=>WADO1_out);
