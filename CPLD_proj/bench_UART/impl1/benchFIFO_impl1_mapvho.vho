    VARIABLE WD0_WCK_TimingDatash	: VitalTimingDataType;
    VARIABLE tviol_WD1_WCK       	: x01 := '0';
    VARIABLE WD1_WCK_TimingDatash	: VitalTimingDataType;
    VARIABLE tviol_WCK_WCK          	: x01 := '0';
