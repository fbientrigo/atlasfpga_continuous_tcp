    component bufferB
      port (I: in Std_logic; Z: out Std_logic);
    end component;
  begin
    fifo_fifo_pfu_10_1_WD0_INT: bufferB
      port map (I=>A1_ipd, Z=>WDO0_out);
    fifo_fifo_pfu_10_1_WD1_INT: bufferB
      port map (I=>B1_ipd, Z=>WDO1_out);
    fifo_fifo_pfu_10_1_WD2_INT: bufferB
      port map (I=>C1_ipd, Z=>WDO2_out);
