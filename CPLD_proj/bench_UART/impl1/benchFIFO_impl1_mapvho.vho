  entity fifo_fifo_pfu_10_1 is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "fifo_fifo_pfu_10_1";

      tipd_D1  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_C1  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_B1  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_A1  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_D0  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_C0  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_B0  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_A0  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_D1_WDO3	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_C1_WDO2	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_B1_WDO1	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_A1_WDO0	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_D0_WADO3	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_C0_WADO2	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_B0_WADO1	 : VitalDelayType01 := (0 ns, 0 ns);
      tpd_A0_WADO0	 : VitalDelayType01 := (0 ns, 0 ns));

    port (D1: in Std_logic; C1: in Std_logic; B1: in Std_logic; 
          A1: in Std_logic; D0: in Std_logic; C0: in Std_logic; 
          B0: in Std_logic; A0: in Std_logic; WADO0: out Std_logic; 
          WADO1: out Std_logic; WADO2: out Std_logic; WADO3: out Std_logic; 
          WDO0: out Std_logic; WDO1: out Std_logic; WDO2: out Std_logic; 
          WDO3: out Std_logic);

    ATTRIBUTE Vital_Level0 OF fifo_fifo_pfu_10_1 : ENTITY IS TRUE;

  end fifo_fifo_pfu_10_1;

  architecture Structure of fifo_fifo_pfu_10_1 is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

    signal D1_ipd 	: std_logic := 'X';
    signal C1_ipd 	: std_logic := 'X';
    signal B1_ipd 	: std_logic := 'X';
