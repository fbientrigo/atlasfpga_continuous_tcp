                RA2=>C0_ipd, RA3=>D0_ipd, WA0=>WAD0_dly, WA1=>WAD1_dly, 
                WA2=>WAD2_dly, WA3=>WAD3_dly, WRE=>WRE_dly, WCK=>WCK_dly, 
                DO0=>F0_out, DO1=>F1_out);

    --  INPUT PATH DELAYs
