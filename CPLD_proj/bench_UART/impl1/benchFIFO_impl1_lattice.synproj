-a "MachXO3D"
-d LCMXO3D-9400HC
-t CABGA256
-s 5
-frequency 100
-optimization_goal Balanced
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-force_gsr No
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-mux_style Auto
-max_fanout 1000
-fsm_encoding_style Auto

-fix_gated_clocks 1
-loop_limit 1950



-use_io_insertion 1
-resolve_mixed_drivers 0
-use_io_reg auto


-lpf 1
-lib "work" -vhd "C:/Users/victo/Desktop/Lattice_proj/bench_UART/uart_top.vhd"
"C:/Users/victo/Desktop/Lattice_proj/bench_UART/FIFO2UART.vhd"
"C:/Users/victo/Desktop/Lattice_proj/bench_UART/b13fifo.vhd"
"C:/Users/victo/Desktop/Lattice_proj/bench_UART/UART_TX.vhd"
"C:/Users/victo/Desktop/Lattice_proj/bench_UART/UART_RX.vhd"
-top uart_top


-p "C:/lscc/diamond/3.12/ispfpga/se5c00/data" "C:/Users/victo/Desktop/Lattice_proj/bench_UART/impl1" "C:/Users/victo/Desktop/Lattice_proj/bench_UART"

-ngd "benchFIFO_impl1.ngd"

