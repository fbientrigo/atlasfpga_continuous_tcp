module OSCJ_B ( input STDBY, output OSC, SEDSTDBY, OSCESB );

  OSCJ INST10( .STDBY(STDBY), .SEDSTDBY(SEDSTDBY), .OSC(OSC), .OSCESB(OSCESB));
  defparam INST10.NOM_FREQ = "14.00";
endmodule

module GSR_INST ( input GSRNET );

  GSR5MODE GSR_INST_GSRMODE( .GSR(GSRNET));

  specify
  endspecify

endmodule

module GSR5MODE ( input GSR );
  wire   GSRMODE;

  INV INST10( .A(GSR), .Z(GSRMODE));
  GSR INST20( .GSR(GSRMODE));
endmodule
