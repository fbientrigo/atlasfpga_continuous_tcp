module se5iobuf ( input I, T, output PAD );

  OBZPD INST5( .I(I), .T(T), .O(PAD));
endmodule

module OSCInst0 ( output OSC );
  wire   GNDI;

  OSCJ_B OSCInst0_OSCJ( .STDBY(GNDI), .OSC(OSC), .SEDSTDBY(), .OSCESB());
  gnd DRIVEGND( .PWR0(GNDI));
