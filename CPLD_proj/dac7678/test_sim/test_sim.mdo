if {![file exists "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim/test_sim.mpf"]} { 
	project new "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim" test_sim
	project addfile "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim/dac7678_i2c.vhd"
	project addfile "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim/top_sim.vhd"
	vlib  work
	vdel -lib work -all 
	vlib work
	vcom -work work "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim/dac7678_i2c.vhd"
	vcom -work work "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim/top_sim.vhd"
} else {
	project open "C:/Users/victo/Desktop/Lattice_proj/dac7678/test_sim/test_sim"
	project compileoutofdate
}
vsim -L work -L pmi_work -L ovi_machxo3d  top_sim
view wave
add wave /*
run 1000ns
