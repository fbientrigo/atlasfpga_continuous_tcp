module update_i ( output PADDI, input update_i );

  se5iobuf0051 update_i_pad( .Z(PADDI), .PAD(update_i));

  specify
    (update_i => PADDI) = (0:0:0,0:0:0);
    $width (posedge update_i, 0:0:0);
    $width (negedge update_i, 0:0:0);
  endspecify

endmodule

module GSR_INST ( input GSRNET );

  GSR5MODE GSR_INST_GSRMODE( .GSR(GSRNET));

  specify
  endspecify

endmodule

module GSR5MODE ( input GSR );
  wire   GSRMODE;

  INV INST10( .A(GSR), .Z(GSRMODE));
  GSR INST20( .GSR(GSRMODE));
endmodule
