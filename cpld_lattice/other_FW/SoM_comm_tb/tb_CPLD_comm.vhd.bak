library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

-- Uncomment the following library declaration if using
-- arithmetic functions with Signed or Unsigned values
use IEEE.NUMERIC_STD.ALL;

-- Uncomment the following library declaration if instantiating
-- any Xilinx leaf cells in this code.

entity tb_CPLD_comm is
--  Port ( );
end tb_CPLD_comm;

architecture Behavioral of tb_CPLD_comm is
component CPLD_comm_module
generic(
        SPI_baud_rate : integer :=10000000; --SPI frequency
        input_clock_freq : integer := 100000000; -- input clock frequency 100 MHz
        SPI_word_lenght : integer := 10
    );
  Port ( 
        i_clk: in std_logic;
        i_rst: in std_logic;
        i_Mezz_mux  : in std_logic_vector( 2 downto 0); --For mux ADC inputs 
        i_SPI_Mezz_sel : in std_logic_vector( 2 downto 0);
        i_SPI_WR_en : in std_logic; --when asserted, write to SPI bus of CPLD
        i_Mux_CAL_signal: in std_logic;-- enable or disable the mux from external calibration signal THIS IS NOT IMPLEMENTED IN THE ACTUAL VERSION OF THE CMB MOTHERBOARD
        i_nRST: in std_logic; --nRST of mezzanines
        i_DAC_Sel: in std_logic_vector(1 downto 0);--Select dac0 or dac1 of the mezzanine
        i_nSHDN: in std_logic;--Power the selected mezzanines
        i_Denable: in std_logic;--Select denable of DRS4 to start sampling ring
	i_SPI_MISO: in std_logic;
	i_nCS_CPLD : in std_logic;
		i_ADC_nCS: in std_logic;
        ---OUTPUTS physical
        o_Mux_sel : out std_logic_vector(2 downto 0); -- mux of mezzanines
        o_SPI_MOSI: out std_logic;
        o_SPI_SCLK: out std_logic;
        o_SPI_nCS : out std_logic;
        ---OUTPUTS for control
        o_wr_rdy : out std_logic---ready to receive new data
  
  );
end component;

Component SPI_som
Port(
		MOSI_som : in std_logic;
		MCLK_som : in std_logic;
		CS_som	:	in std_logic;
		data_rec: out std_logic_vector(9 downto 0);
		data_rdy: out std_logic
);
end component;


signal clk,rst : std_logic;
signal mezz_mux : std_logic_vector( 2 downto 0);
signal SPI_mezz_sel : std_logic_vector ( 2 downto 0);
signal SPI_WR_en : std_logic;
signal mux_cal_signal, nRst,nshdn,denable,SPI_MOSI,SPI_SCLK,wr_rdy,SPI_nCS,ADC_nCS: std_logic;
signal mux_sel : std_logic_vector (2 downto 0);
signal dac_sel : std_logic_vector (1 downto 0);
signal data_received : std_logic_vector(9 downto 0);
signal data_rdy : std_logic;
constant T : time := 10 ns; 

begin

CPLD:SPI_som
Port Map
(
	MOSI_som => SPI_MOSI,
	MCLK_som =>SPI_SCLK,
	CS_som	=> SPI_nCS,
	data_rec =>data_received,
	data_rdy => data_rdy

);

SoM:CPLD_comm_module
Port Map(
    i_clk => clk,
    i_rst => rst,
	i_Mezz_mux => mezz_mux,
	i_SPI_Mezz_sel => SPI_mezz_sel,
	i_SPI_WR_en => SPI_WR_en,
	i_Mux_CAL_signal => mux_cal_signal,
	i_nRST => nRst,
	i_DAC_Sel => dac_sel,
	i_nSHDN => nshdn,
	i_Denable => denable,
	i_ADC_nCS => ADC_nCS,
	o_Mux_sel => mux_sel,
	o_SPI_MOSI => SPI_MOSI,
	o_SPI_SCLK => SPI_SCLK,
	o_SPI_nCS => SPI_nCS,
	o_wr_rdy => wr_rdy
);

process 
    begin
        clk <= '0';
        wait for T/2;
        clk <= '1';
        wait for T/2;
    end process;

variable_proc:process
begin
rst <= '1';
mezz_mux <= b"110";
SPI_mezz_sel <= b"011";
SPI_WR_en <= '0';
mux_cal_signal <= '1';
nRst <= '0';
dac_sel <= b"01";
nshdn <= '0';
denable <= '1';
ADC_nCS <= '0';
wait for 100 ns;
rst <= '0';
SPI_WR_en <= '1';
wait for 100 ns;
SPI_WR_en <= '0';
mezz_mux <= b"001";

wait for 5000 ns;
mezz_mux <= b"010";
SPI_mezz_sel <= b"111";
SPI_WR_en <= '0';
mux_cal_signal <= '1';
nRst <= '0';
dac_sel <= b"01";
nshdn <= '1';
denable <= '0';
ADC_nCS <= '1';
wait for 100 ns;
SPI_WR_en <= '1';
wait;

end process;

end Behavioral;

