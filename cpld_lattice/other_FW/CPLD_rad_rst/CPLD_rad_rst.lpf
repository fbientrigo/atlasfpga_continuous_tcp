BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
SYSCONFIG MASTER_SPI_PORT=DISABLE CONFIGURATION=CFG MCCLK_FREQ=66.5 ;
#LOCATE COMP "Uart_tx_P" SITE "B2" ;
#LOCATE COMP "Uart_tx_N" SITE "A3" ;
#IOBUF PORT "Uart_tx_P" PULLMODE=DOWN IO_TYPE=LVDS25 ;
#IOBUF PORT "Uart_tx_N" PULLMODE=DOWN IO_TYPE=LVDS25 ;
USE PRIMARY NET "osc_int" ;
LOCATE COMP "Uart_tx_P" SITE "B2" ;
LOCATE COMP "rst_i" SITE "B1" ;
IOBUF PORT "rst_i" IO_TYPE=LVCMOS25 ;
IOBUF PORT "Uart_tx_P" IO_TYPE=LVDS25E ;
