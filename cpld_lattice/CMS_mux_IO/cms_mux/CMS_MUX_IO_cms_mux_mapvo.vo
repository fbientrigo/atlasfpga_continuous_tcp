module GSR5MODE ( input GSR );
  wire   GSRMODE;

  INV INST10( .A(GSR), .Z(GSRMODE));
  GSR INST20( .GSR(GSRMODE));
endmodule

module h_beat_Clock_inst ( input STDBY, output OSC );

  OSCH_B \h_beat/Clock_inst_OSCH ( .STDBY(STDBY), .OSC(OSC), .SEDSTDBY());
endmodule

module OSCH_B ( input STDBY, output OSC, SEDSTDBY );

  OSCH INST10( .STDBY(STDBY), .OSC(OSC), .SEDSTDBY(SEDSTDBY));
  defparam INST10.NOM_FREQ = "10.23";
endmodule
