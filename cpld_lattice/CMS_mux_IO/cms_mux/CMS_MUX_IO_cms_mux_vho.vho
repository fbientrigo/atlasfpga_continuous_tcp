    BEGIN

    IF (TimingChecksOn) THEN
      VitalPeriodPulseCheck (
        TestSignal => DRS4irefclkp_ipd,
        TestSignalName => "DRS4irefclkp",
        Period => tperiod_DRS4irefclkp,
        PulseWidthHigh => tpw_DRS4irefclkp_posedge,
        PulseWidthLow => tpw_DRS4irefclkp_negedge,
        PeriodData => periodcheckinfo_DRS4irefclkp,
        Violation => tviol_DRS4irefclkp_DRS4irefclkp,
        MsgOn => MsgOn, XOn => XOn,
        HeaderMsg => InstancePath,
        CheckEnabled => TRUE,
        MsgSeverity => warning);

    END IF;

    PADDI_zd 	:= PADDI_out;

    VitalPathDelay01 (
      OutSignal => PADDI, OutSignalName => "PADDI", OutTemp => PADDI_zd,
