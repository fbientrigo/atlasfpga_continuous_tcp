      tipd_T  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_DRS4irefclkp_PADDI	 : VitalDelayType01 := (0 ns, 0 ns);
      tperiod_DRS4irefclkp 	: VitalDelayType := 0 ns;
      tpw_DRS4irefclkp_posedge	: VitalDelayType := 0 ns;
      tpw_DRS4irefclkp_negedge	: VitalDelayType := 0 ns);

    port (PADDI: out Std_logic; DRS4irefclkp: in Std_logic; T: in Std_logic);

