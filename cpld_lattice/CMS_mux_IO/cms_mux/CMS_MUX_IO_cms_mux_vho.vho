-- entity CSR_SCLK_PB
  library IEEE, vital2000, MACHXO3L;
  use IEEE.STD_LOGIC_1164.all;
  use vital2000.vital_timing.all;
  use MACHXO3L.COMPONENTS.ALL;

  entity CSR_SCLK_PB is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "CSR_SCLK_PB";

      tipd_CSRSCLKP  	: VitalDelayType01 := (0 ns, 0 ns);
      tipd_T  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_CSRSCLKP_PADDI	 : VitalDelayType01 := (0 ns, 0 ns);
      tperiod_CSRSCLKP 	: VitalDelayType := 0 ns;
      tpw_CSRSCLKP_posedge	: VitalDelayType := 0 ns;
      tpw_CSRSCLKP_negedge	: VitalDelayType := 0 ns);

    port (PADDI: out Std_logic; CSRSCLKP: in Std_logic; T: in Std_logic);

    ATTRIBUTE Vital_Level0 OF CSR_SCLK_PB : ENTITY IS TRUE;

  end CSR_SCLK_PB;

  architecture Structure of CSR_SCLK_PB is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

    signal PADDI_out 	: std_logic := 'X';
    signal CSRSCLKP_ipd 	: std_logic := 'X';
    signal T_ipd 	: std_logic := 'X';

    component xo2iobuf0169
      port (T: in Std_logic; Z: out Std_logic; PAD: in Std_logic);
    end component;
  begin
    SCLK_clk: xo2iobuf0169
      port map (T=>T_ipd, Z=>PADDI_out, PAD=>CSRSCLKP_ipd);

    --  INPUT PATH DELAYs
    WireDelay : BLOCK
    BEGIN
      VitalWireDelay(CSRSCLKP_ipd, CSRSCLKP, tipd_CSRSCLKP);
      VitalWireDelay(T_ipd, T, tipd_T);
    END BLOCK;

    VitalBehavior : PROCESS (PADDI_out, CSRSCLKP_ipd, T_ipd)
    VARIABLE PADDI_zd         	: std_logic := 'X';
    VARIABLE PADDI_GlitchData 	: VitalGlitchDataType;

    VARIABLE tviol_CSRSCLKP_CSRSCLKP          	: x01 := '0';
    VARIABLE periodcheckinfo_CSRSCLKP	: VitalPeriodDataType;

    BEGIN

    IF (TimingChecksOn) THEN
      VitalPeriodPulseCheck (
        TestSignal => CSRSCLKP_ipd,
        TestSignalName => "CSRSCLKP",
        Period => tperiod_CSRSCLKP,
        PulseWidthHigh => tpw_CSRSCLKP_posedge,
        PulseWidthLow => tpw_CSRSCLKP_negedge,
        PeriodData => periodcheckinfo_CSRSCLKP,
        Violation => tviol_CSRSCLKP_CSRSCLKP,
        MsgOn => MsgOn, XOn => XOn,
        HeaderMsg => InstancePath,
        CheckEnabled => TRUE,
        MsgSeverity => warning);

    END IF;

    PADDI_zd 	:= PADDI_out;

    VitalPathDelay01 (
      OutSignal => PADDI, OutSignalName => "PADDI", OutTemp => PADDI_zd,
      Paths      => (0 => (InputChangeTime => CSRSCLKP_ipd'last_event,
                           PathDelay => tpd_CSRSCLKP_PADDI,
                           PathCondition => TRUE)),
      GlitchData => PADDI_GlitchData,
      Mode       => vitaltransport, XOn => XOn, MsgOn => MsgOn);

    END PROCESS;

  end Structure;

