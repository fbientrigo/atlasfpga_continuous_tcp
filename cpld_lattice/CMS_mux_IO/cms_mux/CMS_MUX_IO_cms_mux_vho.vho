  use IEEE.STD_LOGIC_1164.all;
  use vital2000.vital_timing.all;
  use MACHXO3L.COMPONENTS.ALL;

  entity CSR_CS_SOMB is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "CSR_CS_SOMB";

      tipd_CSRCSSOM  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_CSRCSSOM_PADDI	 : VitalDelayType01 := (0 ns, 0 ns);
      tperiod_CSRCSSOM 	: VitalDelayType := 0 ns;
      tpw_CSRCSSOM_posedge	: VitalDelayType := 0 ns;
      tpw_CSRCSSOM_negedge	: VitalDelayType := 0 ns);

    port (PADDI: out Std_logic; CSRCSSOM: in Std_logic);

    ATTRIBUTE Vital_Level0 OF CSR_CS_SOMB : ENTITY IS TRUE;

  end CSR_CS_SOMB;

  architecture Structure of CSR_CS_SOMB is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

    signal PADDI_out 	: std_logic := 'X';
    signal CSRCSSOM_ipd 	: std_logic := 'X';

    component xo2iobuf0171
      port (Z: out Std_logic; PAD: in Std_logic);
    end component;
  begin
    CSR_CS_SOM_pad: xo2iobuf0171
      port map (Z=>PADDI_out, PAD=>CSRCSSOM_ipd);

    --  INPUT PATH DELAYs
    WireDelay : BLOCK
    BEGIN
      VitalWireDelay(CSRCSSOM_ipd, CSRCSSOM, tipd_CSRCSSOM);
    END BLOCK;

    VitalBehavior : PROCESS (PADDI_out, CSRCSSOM_ipd)
    VARIABLE PADDI_zd         	: std_logic := 'X';
    VARIABLE PADDI_GlitchData 	: VitalGlitchDataType;

    VARIABLE tviol_CSRCSSOM_CSRCSSOM          	: x01 := '0';
    VARIABLE periodcheckinfo_CSRCSSOM	: VitalPeriodDataType;

    BEGIN

    IF (TimingChecksOn) THEN
      VitalPeriodPulseCheck (
        TestSignal => CSRCSSOM_ipd,
        TestSignalName => "CSRCSSOM",
        Period => tperiod_CSRCSSOM,
        PulseWidthHigh => tpw_CSRCSSOM_posedge,
        PulseWidthLow => tpw_CSRCSSOM_negedge,
        PeriodData => periodcheckinfo_CSRCSSOM,
        Violation => tviol_CSRCSSOM_CSRCSSOM,
        MsgOn => MsgOn, XOn => XOn,
        HeaderMsg => InstancePath,
        CheckEnabled => TRUE,
        MsgSeverity => warning);

    END IF;

    PADDI_zd 	:= PADDI_out;

    VitalPathDelay01 (
      OutSignal => PADDI, OutSignalName => "PADDI", OutTemp => PADDI_zd,
      Paths      => (0 => (InputChangeTime => CSRCSSOM_ipd'last_event,
                           PathDelay => tpd_CSRCSSOM_PADDI,
                           PathCondition => TRUE)),
      GlitchData => PADDI_GlitchData,
      Mode       => vitaltransport, XOn => XOn, MsgOn => MsgOn);

    END PROCESS;

  end Structure;

