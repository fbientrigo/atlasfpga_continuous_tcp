      port map (PWR0=>GNDI);
    SPI_echo_word_i0_i12: vmuxregsre0034
      port map (D0=>M0_dly, D1=>VCCI, SD=>GNDI, SP=>CE_dly, CK=>CLK_dly, 
                LSR=>LSR_dly, Q=>Q0_out);

    --  INPUT PATH DELAYs
