    SPI_i1_2_lut_rep_24: lut40035
      port map (A=>A1_ipd, B=>GNDI, C=>GNDI, D=>D1_ipd, Z=>F1_out);
    DRIVEGND: gnd
      port map (PWR0=>GNDI);
    SPI_i1250_2_lut: lut40036
      port map (A=>A0_ipd, B=>GNDI, C=>GNDI, D=>D0_ipd, Z=>F0_out);
    SPI_SPI_states_ack_i1: vmuxregsre0018
