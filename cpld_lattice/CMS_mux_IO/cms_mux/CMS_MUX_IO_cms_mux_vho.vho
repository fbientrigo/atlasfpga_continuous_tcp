    signal DRS4irefclkp_ipd 	: std_logic := 'X';
    signal T_ipd 	: std_logic := 'X';

    component xo2iobuf0163
      port (T: in Std_logic; Z: out Std_logic; PAD: in Std_logic);
    end component;
  begin
    DRS4_refclk_in: xo2iobuf0163
      port map (T=>T_ipd, Z=>PADDI_out, PAD=>DRS4irefclkp_ipd);

    --  INPUT PATH DELAYs
    WireDelay : BLOCK
    BEGIN
      VitalWireDelay(DRS4irefclkp_ipd, DRS4irefclkp, tipd_DRS4irefclkp);
      VitalWireDelay(T_ipd, T, tipd_T);
    END BLOCK;

    VitalBehavior : PROCESS (PADDI_out, DRS4irefclkp_ipd, T_ipd)
    VARIABLE PADDI_zd         	: std_logic := 'X';
    VARIABLE PADDI_GlitchData 	: VitalGlitchDataType;

    VARIABLE tviol_DRS4irefclkp_DRS4irefclkp          	: x01 := '0';
